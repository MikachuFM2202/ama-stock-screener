#!/bin/sh
# Stamps index.html with a fresh ?v= on every commit so browsers fetch matching app/module/CSS files after a deploy.
v=$(date -u +%Y%m%d%H%M%S)
sed -i '' -E "s/(app\.js|style\.css)\?v=[0-9]+/\1?v=$v/g" index.html 2>/dev/null || sed -i -E "s/(app\.js|style\.css)\?v=[0-9]+/\1?v=$v/g" index.html
G=/Library/Developer/CommandLineTools/usr/bin/git; [ -x "$G" ] || G=git  # /usr/bin/git is blocked by the Xcode licence on this Mac
"$G" add index.html
